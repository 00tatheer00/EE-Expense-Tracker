# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of this app (used for links inside notification emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email notifications (any SMTP provider: Gmail app password, Resend, Brevo, Zoho, etc.) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
EMAIL_FROM="EE Expense Tracker <you@example.com>"

# --- Demo mode: run on in-memory sample data, no Supabase needed ---
# NEXT_PUBLIC_DEMO_MODE=true
